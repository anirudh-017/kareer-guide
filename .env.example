# ---------------------------------------------------------------------------
# Kareer Guide — environment
#
# Server-only secrets. These are read by the TanStack Start server functions in
# src/lib/*.server.ts and are NEVER exposed to the browser. Set them in your
# host's dashboard for production; copy this file to `.env` for local dev.
# ---------------------------------------------------------------------------

# REQUIRED. Lovable AI gateway key (Gemini 3 Flash) — powers resume skill
# extraction, resume analysis and resume tailoring. Without it those features
# fail with a clear error; the rest of the app still renders.
LOVABLE_API_KEY=

# REQUIRED for /roadmap. Groq runs career roadmap generation on
# openai/gpt-oss-120b — one bounded JSON response, ~5s. https://console.groq.com
# If this is empty, roadmaps fall back to the Lovable gateway above and the
# swap is logged server-side.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Job sources. Every one is optional: a source with no key is skipped silently,
# and the remaining sources still return results. More keys = better coverage.
# ---------------------------------------------------------------------------

# RapidAPI — powers both JSearch (jobs) and the Internships API.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna — the only source that respects the user's country.
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — https://jooble.org/api/about
JOOBLE_API_KEY=

# Findwork.dev — https://findwork.dev/developers/
FINDWORK_API_KEY=

# Firecrawl — scrapes Internshala, LinkedIn Jobs and Indeed.
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# Keyless sources (no configuration needed): Remotive, Arbeitnow, Jobicy,
# RemoteOK, The Muse, Himalayas, WeWorkRemotely.

# ---------------------------------------------------------------------------
# Public values. VITE_-prefixed vars are inlined into the client bundle, so
# never put a secret here.
# ---------------------------------------------------------------------------

# Optional. Google Tag Manager container (e.g. GTM-XXXXXXX). Analytics stays
# completely inert — no script, no noscript iframe — while this is empty.
VITE_GTM_ID=
